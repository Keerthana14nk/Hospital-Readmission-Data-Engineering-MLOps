# Airflow login
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=Airflow@123

# Optional Fernet key. Leaving blank is acceptable for local classroom use.
FERNET_KEY=

# Existing Windows PostgreSQL credentials used by the project ETL.
# The compose file forces POSTGRES_HOST=host.docker.internal.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=hospital_readmission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

DATA_DIR=data
RAW_DIR=data/raw
STAGING_DIR=data/staging
CLEANED_DIR=data/cleaned
ERROR_DIR=data/errors
